{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDataEngineeringBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::data-engineering-study-nyoshida880925-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "processed/python-pipeline/matches/*",
            "scripts/glue/*",
            "processed/glue-job/matches-summary/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadGlueInputsAndScripts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::data-engineering-study-nyoshida880925-2026/processed/python-pipeline/matches/*",
        "arn:aws:s3:::data-engineering-study-nyoshida880925-2026/scripts/glue/*"
      ]
    },
    {
      "Sid": "ManageGlueOutputs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::data-engineering-study-nyoshida880925-2026/processed/glue-job/matches-summary/*"
    }
  ]
}
